import { Theme } from "../theme.slint";
import { HorizontalBox } from "std-widgets.slint";
import { Kbd } from "kbd.slint";
export { Theme }

export component Footer inherits Rectangle {
  Rectangle {
    y: 0;
    height: 1px;
    background: Theme.neutralSecondary.transparentize(0.7);
  }

  Rectangle {
    background: Theme.neutral.transparentize(0.8);
    HorizontalLayout {
      alignment: end;
      padding-left: 12px;
      padding-right: 12px;
      padding-top: 8px;
      padding-bottom: 8px;
      spacing: 8px;
      Kbd {
        label: "Esc";
      }
      Text {
        text: "Dismiss";
        vertical-alignment: center;
      }
    }
  }
}
